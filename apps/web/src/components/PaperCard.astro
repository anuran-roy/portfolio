---
import { Card, CardContent } from "@workspace/ui/components/card"
import { Badge } from "@workspace/ui/components/badge"
import type { Paper } from "@/lib/content"

interface Props {
  paper: Paper
}
const { paper } = Astro.props
const { title, description, tags, doi, links } = paper.data
---

<Card className="h-full">
  <CardContent className="flex h-full flex-col gap-3 p-5">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-heading text-lg font-semibold">
        <a href={`/papers/${paper.id}`} class="hover:underline">{title}</a>
      </h3>
      {
        doi && (
          <a
            href={`https://doi.org/${doi}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Badge variant="outline" className="shrink-0 font-mono text-xs">
              DOI
            </Badge>
          </a>
        )
      }
    </div>
    <p class="text-sm text-muted-foreground">{description}</p>
    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.slice(0, 6).map((t) => (
            <span class="border border-border px-1.5 py-0.5 font-mono text-[11px] text-muted-foreground">
              {t}
            </span>
          ))}
        </div>
      )
    }
    {
      links.length > 0 && (
        <div class="mt-auto flex flex-wrap gap-3 pt-2 text-sm">
          {links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-foreground underline-offset-4 hover:underline"
            >
              {link.label} ↗
            </a>
          ))}
        </div>
      )
    }
  </CardContent>
</Card>
