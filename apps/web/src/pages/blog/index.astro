---
import BaseLayout from "@/layouts/BaseLayout.astro"
import PostCard from "@/components/PostCard.astro"
import { getBlogPosts } from "@/lib/content"
import { site } from "@/config/site"

const posts = await getBlogPosts()
const pagePosts = posts.slice(0, site.blog.postsPerPage)
const hasMore = posts.length > site.blog.postsPerPage
const lastPage = Math.ceil(posts.length / site.blog.postsPerPage)
---

<BaseLayout title="Blog" description="Writing on Python, ML, NLP, and open source.">
  <header class="mb-8">
    <h1 class="font-heading text-3xl font-bold tracking-tight">Blog</h1>
    <p class="mt-2 text-muted-foreground">
      Notes on Python, machine learning, NLP, and open-source tinkering.
    </p>
    <p class="mt-4 flex gap-4 text-sm">
      <a href="/blog/categories" class="hover:underline">Categories</a>
      <a href="/blog/tags" class="hover:underline">Tags</a>
    </p>
  </header>

  <div class="grid gap-4 sm:grid-cols-2">
    {pagePosts.map((post) => <PostCard post={post} />)}
  </div>

  {
    hasMore && (
      <nav class="mt-8 flex items-center justify-end text-sm">
        <a href="/blog/page/2" class="hover:underline">
          Older → (page 2 of {lastPage})
        </a>
      </nav>
    )
  }
</BaseLayout>
