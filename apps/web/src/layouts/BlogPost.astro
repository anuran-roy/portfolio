---
import type { MarkdownHeading } from "astro"
import { Comments } from "@/components/Comments"
import RelatedPosts from "@/components/RelatedPosts.astro"
import TableOfContents from "@/components/TableOfContents.astro"
import TagBadge from "@/components/TagBadge.astro"
import { giscusConfigured } from "@/config/site"
import BaseLayout from "@/layouts/BaseLayout.astro"
import {
  type BlogPost as BlogPostEntry,
  formatDate,
  readingTimeOf,
  slugify,
} from "@/lib/content"

interface Props {
  post: BlogPostEntry
  headings: MarkdownHeading[]
  related: BlogPostEntry[]
}
const { post, headings, related } = Astro.props
const { title, description, date, tags, categories, series, comments } =
  post.data
const showComments = comments && giscusConfigured
// astro-llms-md emits a Markdown twin of this page at the same path + ".md".
const markdownUrl = `/blog/${post.id}.md`
---

<BaseLayout
  title={title}
  description={description}
  image={`/open-graph/${post.id}.png`}
  article
  width="wide"
>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_220px]">
    <article class="min-w-0">
      <header class="mb-8 border-b border-border pb-6">
        <div
          class="mb-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground"
        >
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTimeOf(post)}</span>
          {
            series && (
              <>
                <span aria-hidden="true">·</span>
                <a
                  href={`/blog/series/${slugify(series)}`}
                  class="font-mono hover:text-foreground"
                >
                  {series} series
                </a>
              </>
            )
          }
          {
            categories.map((category) => (
              <a
                href={`/blog/categories/${category}`}
                class="font-mono uppercase tracking-wide hover:text-foreground"
              >
                {category}
              </a>
            ))
          }
        </div>
        <h1 class="font-heading text-3xl font-bold tracking-tight text-balance">
          {title}
        </h1>
        <p class="mt-2 text-muted-foreground">{description}</p>
        {
          tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <TagBadge tag={tag} />
              ))}
            </div>
          )
        }
        <div class="mt-4">
          <button
            type="button"
            data-copy-markdown
            data-markdown-url={markdownUrl}
            class="inline-flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1.5 font-mono text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground disabled:opacity-60"
          >
            <svg
              data-icon-copy
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
            </svg>
            <svg
              data-icon-check
              class="hidden"
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 6 9 17l-5-5" />
            </svg>
            <span data-copy-label>Copy as Markdown</span>
          </button>
        </div>
      </header>

      <div
        class="prose prose-neutral max-w-none dark:prose-invert prose-headings:font-heading prose-headings:scroll-mt-20 prose-a:text-foreground prose-pre:p-0"
      >
        <slot />
      </div>

      <RelatedPosts posts={related} />

      {
        showComments && (
          <section class="mt-12 border-t border-border pt-8">
            <h2 class="mb-4 font-heading text-lg font-semibold">Comments</h2>
            <Comments client:visible />
          </section>
        )
      }
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-20">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  const button = document.querySelector<HTMLButtonElement>(
    "[data-copy-markdown]"
  )
  if (button) {
    const copyIcon = button.querySelector<SVGElement>("[data-icon-copy]")
    const checkIcon = button.querySelector<SVGElement>("[data-icon-check]")
    const label = button.querySelector<HTMLElement>("[data-copy-label]")
    const url = button.dataset.markdownUrl
    let resetTimer: ReturnType<typeof setTimeout> | undefined

    const setState = (text: string, copied: boolean) => {
      if (label) label.textContent = text
      copyIcon?.classList.toggle("hidden", copied)
      checkIcon?.classList.toggle("hidden", !copied)
    }

    button.addEventListener("click", async () => {
      if (!url) return
      try {
        const response = await fetch(url)
        if (!response.ok) throw new Error(`HTTP ${response.status}`)
        const markdown = await response.text()
        await navigator.clipboard.writeText(markdown)
        setState("Copied!", true)
      } catch (error) {
        console.error("Failed to copy Markdown:", error)
        setState("Copy failed", false)
      }
      clearTimeout(resetTimer)
      resetTimer = setTimeout(() => setState("Copy as Markdown", false), 2000)
    })
  }
</script>
