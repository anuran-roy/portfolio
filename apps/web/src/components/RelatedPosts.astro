---
import { formatDate, type BlogPost } from "@/lib/content"

interface Props {
  posts: BlogPost[]
}
const { posts } = Astro.props
---

{
  posts.length > 0 && (
    <section class="mt-12 border-t border-border pt-8">
      <h2 class="mb-4 font-heading text-lg font-semibold">Related posts</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class="block border border-border p-4 transition-colors hover:border-foreground/30"
            >
              <time
                datetime={post.data.date.toISOString()}
                class="text-xs text-muted-foreground"
              >
                {formatDate(post.data.date)}
              </time>
              <p class="mt-1 font-medium leading-snug">{post.data.title}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
